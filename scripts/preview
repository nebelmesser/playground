#!/usr/bin/env bash
# Local GitHub Pages preview: Jekyll over HTTP on :4000.
#   ./scripts/preview          start anything that is down, then print status
#   ./scripts/preview status   print status only
#   ./scripts/preview down     stop the stack
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUBY_BIN="/opt/homebrew/opt/ruby@3.3/bin"
PREVIEW_PORT="${PREVIEW_PORT:-4000}"
LEGACY_JEKYLL_PORT="${LEGACY_JEKYLL_PORT:-4001}"
RUN_DIR="${ROOT}/.preview"
JEKYLL_LOG="${RUN_DIR}/jekyll.log"

usage() {
  cat <<EOF
Usage: ./scripts/preview [status|up|down]

  status   who is listening
  up       start missing processes; no-op if already running
  down     stop Jekyll :${PREVIEW_PORT}

  ./scripts/preview          same as up, then status

Preview: http://127.0.0.1:${PREVIEW_PORT}/
EOF
}

listen_pid() {
  local port="$1"
  lsof -nP -iTCP:"${port}" -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true
}

print_status() {
  local jp
  jp="$(listen_pid "${PREVIEW_PORT}")"
  if [[ -n "${jp}" ]]; then
    echo "jekyll  :${PREVIEW_PORT}  up    pid ${jp}"
    echo "preview http://127.0.0.1:${PREVIEW_PORT}/"
  else
    echo "jekyll  :${PREVIEW_PORT}  down"
    echo "preview down  — run: ./scripts/preview up"
  fi
}

wait_port() {
  local port="$1" name="$2" n=0
  while [[ -z "$(listen_pid "${port}")" ]]; do
    n=$((n + 1))
    if (( n > 40 )); then
      echo "${name} did not bind :${port}" >&2
      return 1
    fi
    sleep 0.25
  done
}

# Double-fork so the process survives the agent/tool shell exiting.
daemonize() {
  local log="$1"
  shift
  python3 - "${log}" "$@" <<'PY'
import os, sys
log, *cmd = sys.argv[1:]
if os.fork() > 0:
    os._exit(0)
os.setsid()
if os.fork() > 0:
    os._exit(0)
devnull = os.open(os.devnull, os.O_RDWR)
os.dup2(devnull, 0)
out = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
os.dup2(out, 1)
os.dup2(out, 2)
os.chdir(os.environ.get("PREVIEW_ROOT", os.getcwd()))
os.execvp(cmd[0], cmd)
PY
}

cmd_up() {
  mkdir -p "${RUN_DIR}"
  export PATH="${RUBY_BIN}:${PATH}"
  export PREVIEW_ROOT="${ROOT}"

  if [[ -z "$(listen_pid "${PREVIEW_PORT}")" ]]; then
    if [[ ! -x "${RUBY_BIN}/ruby" ]]; then
      echo "Ruby 3.3 is missing. Install it with: brew install ruby@3.3" >&2
      exit 1
    fi
    cd "${ROOT}"
    if [[ ! -d vendor/bundle ]]; then
      bundle config set --local path vendor/bundle
      bundle install
    fi
    echo "starting jekyll :${PREVIEW_PORT}"
    daemonize "${JEKYLL_LOG}" bundle exec jekyll serve --host 127.0.0.1 --port "${PREVIEW_PORT}" --baseurl=""
    wait_port "${PREVIEW_PORT}" "jekyll"
  fi
}

cmd_down() {
  local p
  # Also stop the old :4001 backend during migration from the HTTPS proxy stack.
  for p in "$(listen_pid "${PREVIEW_PORT}")" "$(listen_pid "${LEGACY_JEKYLL_PORT}")"; do
    if [[ -n "${p}" ]]; then
      kill "${p}" 2>/dev/null || true
    fi
  done
  sleep 0.3
}

cmd="${1:-up}"
case "${cmd}" in
  -h|--help|help) usage ;;
  status) print_status ;;
  up)
    cmd_up
    print_status
    ;;
  down)
    cmd_down
    print_status
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
